{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noobenkyo",
  "version": "0.1.0",
  "identifier": "com.noobenkyo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "noobenkyo",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
